# Copy to .env and fill in values

# JWT (change in production)
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Admin — path to service account JSON (Firestore + optional Auth sync)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: disable ML models for faster dev (regex + rules only)
SECURITY_DISABLE_SEMANTIC=false

# Demo admin (used if Firestore users collection empty or as seed)
ADMIN_EMAIL=admin@shield.local
ADMIN_PASSWORD=SecureAdmin123!

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
